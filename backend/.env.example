# SaveBuddy Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/savebuddy

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Authentication Secrets (Used in Module 2)
JWT_SECRET=savebuddy_super_secret_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

# Google Gemini API Key (Used in Module 5)
GEMINI_API_KEY=your_gemini_api_key_here
