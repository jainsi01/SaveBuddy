# SaveBuddy Backend Production Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB Production Connection (e.g. MongoDB Atlas or dedicated replica set)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/savebuddy?retryWrites=true&w=majority

# Client Application URL (For CORS validation)
CLIENT_URL=https://savebuddy.app

# Authentication Secrets (Generate using: openssl rand -base64 32)
JWT_SECRET=replace_with_strong_production_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key
GEMINI_API_KEY=replace_with_your_google_gemini_api_key
